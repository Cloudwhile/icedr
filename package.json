{
  "name": "icedr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:app": "pnpm --filter frontend dev",
    "dev:api": "pnpm --filter backend start:dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "package:binary": "node scripts/package-binary.cjs",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "docker:build": "docker compose -f deploy/docker-compose.yml build",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "0.27.7",
    "png-to-ico": "3.0.1",
    "postject": "1.0.0-alpha.6",
    "rcedit": "5.0.2",
    "vitepress": "1.6.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "entities@7.0.1": "patches/entities@7.0.1.patch"
    }
  }
}
