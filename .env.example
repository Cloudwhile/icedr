# ICEDR local development defaults.
# Production must provide DATABASE_*, REDIS_*, S3_*, PUBLIC_SHARE_BASE_URL, and NEXT_PUBLIC_API_BASE_URL.

NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:13001/api

API_PORT=13001
API_HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:13000

DEFAULT_WORKSPACE_ACTOR=Workspace User

ICA_OAUTH_PROVIDER_PROFILE=oidc
ICA_OAUTH_ISSUER_URL=
ICA_OAUTH_CLIENT_ID=icedr-web
ICA_OAUTH_CLIENT_SECRET=
ICA_OAUTH_AUDIENCE=icedr-api
ICA_OAUTH_SCOPES=openid email profile
ICA_OAUTH_REDIRECT_URI=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME=icedr
DATABASE_USER=icedr
DATABASE_PASSWORD=icedr

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DBNAME=0
REDIS_USER=
REDIS_PASSWORD=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=icedr-drive
S3_ACCESS_KEY_ID=icedr
S3_SECRET_ACCESS_KEY=icedr-secret
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_ROOT=data/local-files

PUBLIC_SHARE_BASE_URL=http://localhost:13000/share/s
SHARE_EMAIL_PROVIDER=dev-log
