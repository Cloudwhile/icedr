# ICEDR local development defaults.
# Production must provide DATABASE_*, REDIS_*, S3_*, and PUBLIC_SHARE_BASE_URL.
# Docker's single-container image builds the browser client with same-origin /api by default.

NODE_ENV=development
APP_ENV=development
ALLOW_DEV_MEMORY_STORE=true
SEED_DEMO_DATA=true
VITE_API_BASE_URL=/api

API_PORT=13001
API_HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:13000

DEFAULT_WORKSPACE_ACTOR=Workspace User

# Use oidc for standard OIDC providers. Use icetowne-blog only for the legacy compatibility profile.
ICA_OAUTH_PROVIDER_PROFILE=oidc
ICA_OAUTH_ISSUER_URL=
ICA_OAUTH_CLIENT_ID=icedr-web
ICA_OAUTH_CLIENT_SECRET=
ICA_OAUTH_AUDIENCE=icedr-api
ICA_OAUTH_SCOPES=openid email profile
ICA_OAUTH_REDIRECT_URI=
AUTH_SECURITY_SECRET=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME=icedr
DATABASE_USER=icedr
DATABASE_PASSWORD=icedr

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DBNAME=0
REDIS_USER=
REDIS_PASSWORD=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=icedr-drive
S3_ACCESS_KEY_ID=icedr
S3_SECRET_ACCESS_KEY=icedr-secret
S3_FORCE_PATH_STYLE=true
MINIO_METRICS_ENDPOINT=http://localhost:9000/minio/metrics/v3/cluster/health
MINIO_METRICS_BEARER_TOKEN=
LOCAL_STORAGE_ROOT=data/local-files

PUBLIC_SHARE_BASE_URL=http://localhost:13000/share/s
SHARE_EMAIL_PROVIDER=dev-log
SHARE_VISITOR_HASH_SECRET=
SHARE_RATE_LIMIT_PROFILE=default
# Optional overrides. Leave blank to use the selected profile's limits.
SHARE_RATE_LIMIT_WINDOW_SECONDS=
SHARE_RATE_LIMIT_VIEW_MAX=
SHARE_RATE_LIMIT_VIEW_WINDOW_SECONDS=
SHARE_RATE_LIMIT_EMAIL_CODE_MAX=
SHARE_RATE_LIMIT_EMAIL_CODE_WINDOW_SECONDS=
SHARE_RATE_LIMIT_EMAIL_VERIFY_MAX=
SHARE_RATE_LIMIT_EMAIL_VERIFY_WINDOW_SECONDS=
SHARE_RATE_LIMIT_EMAIL_VERIFY_LOCK_SECONDS=
SHARE_RATE_LIMIT_DOWNLOAD_INTENT_MAX=
SHARE_RATE_LIMIT_DOWNLOAD_INTENT_WINDOW_SECONDS=
SHARE_RATE_LIMIT_DOWNLOAD_MAX=
SHARE_RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=
